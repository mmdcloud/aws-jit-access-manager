# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars if needed
# terraform.tfvars
*.auto.tfvars

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files in ignore list
*.tfplan
*tfplan*

# Ignore CLI config files
.terraformrc
terraform.rc

# Python & Lambda build artifacts
__pycache__/
*.py[cod]
*$py.class
*.zip
terraform/modules/lambda/build/

